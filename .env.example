# =========================================================================
# Photoshop Bulk Ad-Creative Automation — environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env or service_account.json.
# =========================================================================

# --- Google credentials ---------------------------------------------------
# Path to your Google service account JSON key (used for both Sheets + GCS).
# Keep this file out of version control.
SERVICE_ACCOUNT_JSON=service_account.json

# --- Google Sheets (creative specs) --------------------------------------
# Full URL of the spreadsheet that holds the creative specs.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
# Worksheet/tab name to read from.
SHEET_NAME=your-worksheet-name
# Some bulk scripts read the spreadsheet by ID instead of URL.
SHEET_ID=your-sheet-id

# --- Google Cloud Storage -------------------------------------------------
# Bucket where source images live and exported creatives are uploaded.
GCS_BUCKET=your-gcs-bucket-name

# --- AI image / text generation APIs -------------------------------------
OPENAI_API_KEY=your-openai-api-key
MIDJOURNEY_API_KEY=your-midjourney-api-key

# --- Local agent behavior -------------------------------------------------
# Directory holding the JSON task queue.
TASKS_DIR=Tasks
# Python interpreter the agent uses to launch jobs (defaults to "python").
PYTHON_EXECUTABLE=python
# Set to 1 to stop the agent after finishing one task.
AGENT_EXIT_ON_DONE=0
# Stop the agent after this many idle seconds (0 = run forever).
AGENT_EXIT_ON_IDLE_SECONDS=0

# --- Optional: remote task store over SFTP --------------------------------
# Only needed if the cloud UI and the Photoshop host do not share a filesystem.
# Leave REMOTE_HOST empty to use the local task store.
REMOTE_HOST=
REMOTE_USER=your-remote-username
REMOTE_PASSWORD=your-remote-password
REMOTE_PORT=22
REMOTE_PKEY_PATH=your-private-key-path
REMOTE_TASKS_DIR=Tasks

# --- Flask -----------------------------------------------------------------
# Override the development secret key before running in production.
FLASK_SECRET_KEY=your-flask-secret-key
# Set to 1 to enable Flask debug mode (development only).
FLASK_DEBUG=0
# Interface the cloud UI binds to (use 0.0.0.0 to expose beyond localhost).
HOST=127.0.0.1
